RESEARCH_DATA_DIR=data
# Semantic multilingual retrieval and local instruction generation.
# start.ps1 installs dependencies, downloads models and restores the index.
RESEARCH_EMBEDDINGS=sentence-transformers
RESEARCH_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RESEARCH_RERANKER=cross-encoder
RESEARCH_RERANKER_MODEL=corrius/cross-encoder-mmarco-mMiniLMv2-L12-H384-v1
# Leave empty for embedded persistent Qdrant.
RESEARCH_QDRANT_URL=
# OpenAI-compatible chat completions endpoint, e.g. Ollama or hosted provider.
RESEARCH_LLM_URL=
RESEARCH_LLM_KEY=
RESEARCH_LLM_MODEL=
# Set YOUR provider prices in USD per million tokens. Empty = unknown.
RESEARCH_INPUT_PRICE=
RESEARCH_OUTPUT_PRICE=
# Optional Tavily search; only used when explicitly allowed per query.
RESEARCH_TAVILY_KEY=

# Answers use a ready-made local instruction model.
RESEARCH_ANSWER_BACKEND=ollama
RESEARCH_OLLAMA_URL=http://127.0.0.1:11435
RESEARCH_ANSWER_MODEL=qwen2.5:3b
RESEARCH_ANSWER_CONTEXT=6144
RESEARCH_ANSWER_MAX_TOKENS=2000
RESEARCH_MODEL_CACHE=data/models/huggingface/hub
RESEARCH_RETRIEVAL_DEVICE=cpu
RESEARCH_QDRANT_PATH=data/qdrant-semantic
RESEARCH_DENSE_WEIGHT=0.5
RESEARCH_RRF_K=60
RESEARCH_DIVERSITY_PENALTY=0.15
RESEARCH_SEARCH_POOL=20
RESEARCH_RERANK_CANDIDATES=40
RESEARCH_HANDBOOK_BOOST=0.0
RESEARCH_TITLE_WEIGHT=0.0
RESEARCH_RETRIEVAL_K=8
RESEARCH_EVIDENCE_LIMIT=10
RESEARCH_PER_DOCUMENT=3
RESEARCH_PARENT_MAX_CHARS=5000
RESEARCH_COLLAPSE_PARENTS=false
RESEARCH_ENTITY_ROUTING=false
RESEARCH_ANSWER_PROFILE=legacy
RESEARCH_ANSWER_SOURCES=6
RESEARCH_ANSWER_TEMPERATURE=0.0
RESEARCH_TECHNICAL_EXPANSION=false
RESEARCH_ANSWER_SOURCE_FIRST=false
RESEARCH_STRICT_ENTITY_EVIDENCE=false
RESEARCH_TEACHING_PRECISION=false
